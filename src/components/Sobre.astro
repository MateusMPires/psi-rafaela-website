---
/**
 * O arquivo da foto é 9:16 (retrato de celular); o quadro é 4:5. O recorte é
 * feito no CSS (object-position), não no build, para o enquadramento poder ser
 * ajustado sem regerar o asset. Abaixo da dobra: lazy.
 */
import { Image } from 'astro:assets';
import { sobre, profissional } from '../content/site';
---

<section class="secao secao--sobre" id="sobre">
  <div class="container sobre">
    <div class="sobre__retrato">
      <Image
        src={profissional.foto}
        alt={`${profissional.nome}, psicóloga clínica`}
        widths={[400, 620, 900]}
        sizes="(min-width: 900px) 360px, 220px"
        loading="lazy"
      />
    </div>

    <div class="sobre__texto">
      <h2 class="revela">{sobre.titulo}</h2>

      {sobre.paragrafos.map((p) => (
        <p class="sobre__paragrafo revela">{p}</p>
      ))}

      {/* Itálico = a voz dela. Regra do design system. Fecha a seção. */}
      <blockquote class="citacao citacao--fim revela">
        <p>{sobre.citacao}</p>
      </blockquote>

      <ul class="credenciais revela">
        {sobre.credenciais.map((c) => (
          <li class="cred">{c}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Respiro inteiro (não metade) nas duas fronteiras — pedido do Mateus, 09/09/2026.
     Acima, o "Sobre" encosta na única faixa tingida da página e precisa de ar para
     não ler como continuação da dobra; abaixo, a fronteira com o Reconhecimento é
     papel contra papel, onde o Divisor sozinho não separa — o espaço é a outra
     metade do trabalho dele. Mesma conta do .secao--linho. */
  .secao--sobre { padding-block: var(--entre-secoes); }

  .sobre { display: grid; gap: var(--s-8); align-items: start; }

  /* height:auto anula o height do atributo (1600) para o aspect-ratio valer.
     75% vertical: rosto no terço de cima, mãos ainda dentro do quadro. */
  /* O quadro fica parado e a foto se abre dentro dele como uma cortina, de
     baixo para cima, assentando de um zoom de 8%: é a pessoa aparecendo, não um
     bloco de layout deslizando. */
  .sobre__retrato { border-radius: var(--raio-painel); overflow: hidden; }
  /* No mobile o retrato é um objeto centrado de 220px, não a largura da tela:
     em 4:5 largura cheia ele sozinho ocupava meia tela (Mateus, 22/09/2026). */
  .sobre__retrato { width: 100%; max-width: 220px; margin-inline: auto; }
  /* Timeline NOMEADA no quadro, e não view() na foto: o overflow:hidden faz do
     quadro um contêiner de rolagem, e o view() da foto passaria a medir a foto
     dentro do quadro (onde ela está sempre visível) em vez de na tela. */
  @supports (animation-timeline: view()) {
    .sobre__retrato { view-timeline: --retrato block; }
    .sobre__retrato img {
      animation-name: retrato;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --retrato;
      animation-range: entry 0% cover 40%;
    }
  }
  @keyframes retrato {
    from {
      clip-path: inset(100% 0 0 0);
      scale: 1.08;
      animation-timing-function: var(--ease-out);
    }
    /* Explícito: de inset() para `none` o navegador não interpola, só salta. */
    to { clip-path: inset(0 0 0 0); scale: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sobre__retrato img { animation-name: surge-fade !important; }
  }

  .sobre__retrato img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5;
    object-fit: cover; object-position: 50% 75%;
    border-radius: var(--raio-painel);
  }

  .citacao { margin: 0; padding: 0 0 0 var(--s-5); border-left: 1px solid var(--ouro); }
  .citacao p { font-style: italic; font-size: var(--t-abertura); line-height: var(--lh-abertura); }
  .citacao--fim { margin-top: var(--s-6); }

  .sobre__paragrafo { margin-top: var(--s-6); }
  h2 + .sobre__paragrafo { margin-top: var(--titulo-corpo); }

  .credenciais {
    list-style: none; margin: var(--s-8) 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6);
  }

  @media (min-width: 900px) {
    .sobre { grid-template-columns: 0.72fr 1.28fr; gap: var(--s-16); }
    .sobre__retrato { max-width: none; margin-inline: 0; }
    .citacao--fim { margin-top: var(--s-8); }
    .credenciais { margin-top: var(--s-10); }
  }
</style>
