---
import { hero, profissional } from '../content/site';
import WhatsAppButton from './WhatsAppButton.astro';
import IlustracaoDobra from './IlustracaoDobra.astro';
---

<section class="hero" id="topo">
  <div class="container hero__inner">
    <div class="hero__texto">
      <h1>{hero.titulo}</h1>
      <p class="abertura titulo-corpo">{hero.subtitulo}</p>

      <div class="hero__acao">
        <WhatsAppButton texto={hero.cta} largo />
      </div>

      <p class="cred hero__cred">{profissional.crp} · {profissional.modalidade}</p>
    </div>

    <div class="hero__ilustracao">
      <IlustracaoDobra />
    </div>
  </div>
</section>

<style>
  /* Linho SÓ na dobra: decisão do Mateus (09/09/2026), depois de testar o bege
     também no "Sobre" e voltar atrás. A dobra é a única faixa tingida da página,
     o que mantém a regra 4 de pé — ela não é desvio de assunto no meio da leitura,
     é a abertura, e não disputa com nenhuma outra faixa. Tingir uma segunda seção
     exige rever a regra 4 antes: foi exatamente o que se desfez aqui. */
  .hero {
    background: var(--linho);
    /* Faixa tingida paga o respiro inteiro por dentro (mesma conta do .secao--linho). */
    padding-block: var(--s-10) var(--entre-secoes);
  }

  .hero__inner { display: grid; gap: var(--s-10); align-items: center; }

  .hero__acao { margin-top: var(--s-8); }
  .hero__cred { margin-top: var(--s-8); }

  /* No mobile a ilustração vem depois do botão e não pode empurrar o CTA para
     fora da primeira tela — por isso ela entra menor e centrada, não largura cheia. */
  .hero__ilustracao {
    max-width: 300px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .hero { padding-block: var(--s-16) var(--entre-secoes); }
    .hero__inner { grid-template-columns: 1.15fr 0.85fr; gap: var(--s-16); }

    /* A ilustração vale 80% da ALTURA do bloco de texto ao lado (pedido do Mateus,
       09/09/2026). O truque é a imagem sair do fluxo: em position:absolute ela não
       entra no cálculo de altura da linha do grid, então a linha continua sendo
       definida pelo texto — e só aí o 80% tem uma altura estável para resolver
       contra. Sem isso a conta fica circular: a imagem (565px de altura intrínseca)
       esticaria a linha, e o 80% passaria a ser 80% dela mesma. */
    .hero__ilustracao {
      max-width: none;
      align-self: stretch;
      position: relative;
      min-height: 0;
      /* Anula o margin-inline:auto da regra mobile. Com a imagem fora do fluxo a
         célula não tem mais conteúdo próprio, e margens automáticas absorveriam
         toda a largura da coluna — o contêiner ia a 0 e a imagem sumia. */
      margin-inline: 0;
    }

    /* Centrada por translate, e NÃO por inset:0 + margin:auto: num elemento
       substituído, `width: auto` com left e right fixos cai na equação de
       preenchimento e resolve para 0 — a imagem some. Com só top/left definidos,
       a largura volta a sair do aspect ratio da altura de 80%. */
    .hero__ilustracao :global(.ilustracao) {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      height: 80%;
      width: auto;
      /* max-width impede a imagem de invadir o gap em telas estreitas, e
         object-fit garante que esse limite encolha o desenho em vez de achatá-lo:
         sem ele, entre 900 e ~1000px a arte sai espremida na horizontal. */
      max-width: 100%;
      object-fit: contain;
    }
  }
</style>
