---
import { hero, profissional } from '../content/site';
import WhatsAppButton from './WhatsAppButton.astro';
import IlustracaoDobra from './IlustracaoDobra.astro';
import Palavras from './Palavras.astro';
---

<section class="hero" id="topo">
  <div class="container hero__inner">
    <div class="hero__texto">
      {/* Entrada em cascata, uma vez ao carregar (global.css). A ordem é a da
          leitura: o título se escreve palavra por palavra, e só quando ele já
          assentou o resto chega (--atraso), terminando no botão. */}
      <h1><Palavras texto={hero.titulo} modo="surge" /></h1>
      <p class="abertura titulo-corpo surge" style="--atraso: 380ms; --ordem: 0">{hero.subtitulo}</p>

      <div class="hero__acao surge" style="--atraso: 380ms; --ordem: 1">
        <WhatsAppButton texto={hero.cta} largo />
      </div>

      <p class="cred hero__cred surge" style="--atraso: 380ms; --ordem: 2">{[profissional.crp, ...hero.etiquetas].join(' · ')}</p>
    </div>

    <div class="hero__ilustracao">
      <IlustracaoDobra />
    </div>
  </div>
</section>

<style>
  /* Linho SÓ na dobra: decisão do Mateus (09/09/2026), depois de testar o bege
     também no "Sobre" e voltar atrás. A dobra é a única faixa tingida da página,
     o que mantém a regra 4 de pé — ela não é desvio de assunto no meio da leitura,
     é a abertura, e não disputa com nenhuma outra faixa. Tingir uma segunda seção
     exige rever a regra 4 antes: foi exatamente o que se desfez aqui. */
  .hero {
    background: var(--linho);
    /* Faixa tingida paga o respiro inteiro por dentro (mesma conta do .secao--linho). */
    padding-block: var(--s-10) var(--entre-secoes);
  }

  .hero__inner { display: grid; gap: var(--s-6); align-items: center; }

  /* A ilustração tem entrada própria, mais longa e mais macia que a do texto:
     ela é o fundo da frase, não mais um item da fila. Depois, quando a dobra
     vai saindo pelo topo, ela sobe um pouco mais devagar e esmaece (uma vez,
     presa à rolagem, sem loop). As duas usam `scale`/`translate` individuais
     de propósito: no desktop o <img> já tem `transform` de centralização, e as
     propriedades individuais se somam a ele em vez de o sobrescrever. */
  .hero { view-timeline: --dobra block; }
  .hero__ilustracao {
    animation: ilustracao 1400ms var(--ease-out) 200ms both;
  }
  @keyframes ilustracao {
    from { opacity: 0; scale: 0.94; filter: blur(8px); }
  }
  @supports (animation-timeline: view()) {
    .hero__ilustracao :global(.ilustracao) {
      animation-name: deriva;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --dobra;
      animation-range: exit 0% exit 100%;
    }
  }
  @keyframes deriva {
    to { translate: 0 -40px; opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__ilustracao { animation: surge-fade 400ms ease both; }
    .hero__ilustracao :global(.ilustracao) { animation: none !important; }
  }

  /* Mais ar entre o título e o subtítulo só na dobra: aqui o título é a primeira
     leitura da página e precisa assentar antes do resto chegar. */
  .hero h1 + .titulo-corpo { margin-top: var(--s-6); }
  .hero__acao { margin-top: var(--s-6); }
  .hero__cred { margin-top: var(--s-6); }

  /* No mobile a ilustração abre a dobra, acima do título, e com 100px não empurra
     o CTA para fora da primeira tela (Mateus, 22/09/2026; antes vinha depois do
     CRP, com 200px). Alinhada à esquerda porque o texto inteiro da dobra é:
     centrada, ela ficaria solta acima de um bloco encostado na margem. */
  .hero__ilustracao {
    order: -1;
    max-width: 100px;
    margin-inline: 0;
  }

  @media (min-width: 900px) {
    .hero { padding-block: var(--s-16) var(--entre-secoes); }
    .hero__acao, .hero__cred { margin-top: var(--s-8); }
    .hero h1 + .titulo-corpo { margin-top: var(--titulo-corpo); }
    .hero__inner { grid-template-columns: 1.15fr 0.85fr; gap: var(--s-16); }

    /* A ilustração vale 80% da ALTURA do bloco de texto ao lado (pedido do Mateus,
       09/09/2026). O truque é a imagem sair do fluxo: em position:absolute ela não
       entra no cálculo de altura da linha do grid, então a linha continua sendo
       definida pelo texto — e só aí o 80% tem uma altura estável para resolver
       contra. Sem isso a conta fica circular: a imagem (565px de altura intrínseca)
       esticaria a linha, e o 80% passaria a ser 80% dela mesma. */
    .hero__ilustracao {
      order: 0;
      max-width: none;
      align-self: stretch;
      position: relative;
      min-height: 0;
      /* Anula o margin-inline:auto da regra mobile. Com a imagem fora do fluxo a
         célula não tem mais conteúdo próprio, e margens automáticas absorveriam
         toda a largura da coluna — o contêiner ia a 0 e a imagem sumia. */
      margin-inline: 0;
    }

    /* Centrada por translate, e NÃO por inset:0 + margin:auto: num elemento
       substituído, `width: auto` com left e right fixos cai na equação de
       preenchimento e resolve para 0 — a imagem some. Com só top/left definidos,
       a largura volta a sair do aspect ratio da altura de 80%. */
    .hero__ilustracao :global(.ilustracao) {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      height: 80%;
      width: auto;
      /* max-width impede a imagem de invadir o gap em telas estreitas, e
         object-fit garante que esse limite encolha o desenho em vez de achatá-lo:
         sem ele, entre 900 e ~1000px a arte sai espremida na horizontal. */
      max-width: 100%;
      object-fit: contain;
    }
  }
</style>
