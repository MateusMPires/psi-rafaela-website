---
import { reconhecimento } from '../content/site';
import Icone from './Icone.astro';
---

<section class="secao secao--pos-divisor" id="reconhecimento">
  <div class="container">
    {/* O título carrega o argumento e a linha de apoio dá o critério: os dois
        abrem a seção, e as seis demandas viram o exemplo do que foi dito. */}
    <h2 class="prosa revela">{reconhecimento.titulo}</h2>
    <p class="abertura titulo-corpo criterio revela">{reconhecimento.subtitulo}</p>

    {/* Sem caixa: um fio no topo de cada coluna separa as seis frentes e para por
        aí. Card com borda, canto e sombra transformaria o argumento principal da
        página em seis produtos numa prateleira. No desktop: duas fileiras de três. */}
    <ul class="demandas">
      {reconhecimento.demandas.map((d) => (
        <li class="demanda revela">
          <span class="demanda__marca">
            <Icone nome={d.icone} tamanho={26} />
          </span>
          <h3 class="demanda__rotulo">{d.rotulo}</h3>
          <p class="demanda__texto">{d.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* No mobile a linha do critério quebra na medida normal. No desktop ela passa
     de 62ch por três caracteres e sobraria uma viúva de duas palavras — daí a
     medida própria, larga só o bastante para a frase caber em uma linha. */
  .criterio { max-width: var(--medida); }

  .demandas {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-10);
  }

  .demanda { border-top: 1px solid var(--fio); padding-top: var(--s-6); }

  /* O disco de linho é o único fundo tingido da seção — dá ao ícone um chão sem
     tingir o argumento inteiro (regra 4). O traço herda --tinta-fraca, nunca
     --ouro: o ouro é da ação (regra 3). */
  .demanda__marca {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--linho);
    color: var(--tinta-fraca);
  }

  /* Os ícones desenham um mecanismo (ver Icone.astro), então eles se desenham
     de verdade: o disco assenta e o traço corre, preso à rolagem da demanda.
     Só os traços com pathLength entram; o tracejado do `limite` só esmaece.
     --desvio atrasa as colunas 2 e 3 no desktop, igual ao texto. */
  .demanda { --desvio: 0%; }
  @supports (animation-timeline: view()) {
    .demanda { view-timeline: --demanda block; }
    .demanda__marca,
    .demanda__marca :global([pathLength]) {
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --demanda;
    }
    .demanda__marca {
      animation-name: disco;
      animation-range: entry var(--desvio) entry calc(50% + var(--desvio));
    }
    .demanda__marca :global([pathLength]) {
      stroke-dasharray: 1;
      animation-name: traco;
      animation-range: entry calc(30% + var(--desvio)) cover calc(45% + var(--desvio));
    }
  }
  @keyframes disco {
    from { opacity: 0; scale: 0.8; animation-timing-function: var(--ease-out); }
  }
  @keyframes traco {
    from { stroke-dashoffset: 1; animation-timing-function: var(--ease-out); }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demanda__marca { animation-name: surge-fade !important; }
    .demanda__marca :global([pathLength]) { animation: none !important; }
  }

  .demanda__rotulo {
    margin-top: var(--s-5);
    font-family: var(--disp);
    font-weight: 400;
    font-size: var(--t-sub);
    line-height: var(--lh-sub);
  }
  .demanda__texto { margin-top: var(--s-3); color: var(--tinta-fraca); }

  @media (min-width: 900px) {
    .criterio { max-width: 76ch; }
    .demandas { grid-template-columns: repeat(3, 1fr); gap: var(--s-10); }

    /* Três colunas cruzam a borda da tela no mesmo instante; o atraso vem da
       rolagem (cada coluna começa um pouco depois), não de um relógio. */
    @supports (animation-timeline: view()) {
      .demanda:nth-child(3n + 2) { --desvio: 10%; animation-range: entry 15% cover 30%; }
      .demanda:nth-child(3n + 3) { --desvio: 20%; animation-range: entry 30% cover 35%; }
    }
  }
</style>
