---
import { comoFunciona } from '../content/site';
---

<section class="secao secao--linho" id="como-funciona">
  <div class="container como">
    <h2 class="prosa revela">{comoFunciona.titulo}</h2>
    <p class="abertura titulo-corpo prosa revela">{comoFunciona.abertura}</p>

    {/* Sequência de verdade: o fio dourado liga os passos e a numeração carrega
        informação. Não é decoração — ver "Ilustração" na base visual.
        No mobile o fio desce; no desktop ele deita e os três passos ficam lado a
        lado, para a seção não virar uma coluna longa de rolagem. */}
    <ol class="passos">
      {comoFunciona.passos.map((passo) => (
        <li class="passo">
          <span class="passo__halo" aria-hidden="true"></span>
          <h3 class="passo__titulo revela">{passo.titulo}</h3>
          <p class="passo__texto revela">{passo.texto}</p>
        </li>
      ))}
    </ol>

    {/* Para onde a terapia aponta — foco do trabalho, não desfecho prometido. */}
    <p class="abertura prosa como__fecho revela">{comoFunciona.fecho}</p>
  </div>
</section>

<style>
  /* Coluna mobile centrada em 660px (regra do CLAUDE.md). No desktop a caixa
     abre até 960px só para caber a grade de três; o texto corrido continua
     preso à medida de leitura e alinhado à primeira coluna. */
  .como { max-width: 660px; margin-inline: auto; }

  .passos {
    list-style: none;
    margin: var(--s-10) 0 0;
    padding: 0;
    max-width: var(--medida);
  }

  /* O fio nasce em cada passo e morre no último ponto — em vez de sobrar
     um rabo de linha depois do fim da sequência. */
  .passo {
    position: relative;
    /* +1px = a antiga border-left, que virou o ::after abaixo para poder ser
       desenhada; o texto não se mexe. */
    padding: 0 0 var(--s-8) calc(var(--s-8) + 1px);
    view-timeline: --passo block;
  }
  .passo:last-child { padding-bottom: 0; }

  /* O fio, agora pseudo-elemento: se desenha de cima para baixo conforme o
     passo sobe na tela. É explicação, não enfeite: mostra que é sequência. */
  .passo::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ouro);
    transform-origin: top;
  }
  .passo:last-child::after { content: none; }

  .passo::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ouro);
  }

  @supports (animation-timeline: view()) {
    .passo::after {
      animation-name: fio-desce;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --passo;
      animation-range: entry 40% cover 55%;
    }
    .passo::before {
      animation-name: ponto;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --passo;
      animation-range: entry 0% entry 40%;
    }
  }
  /* Quando o ponto acende, um anel de ouro abre a partir dele e some: marca
     "chegamos neste passo". Uma vez por passagem, preso à rolagem, sem loop.
     Mesma posição do ponto; o ouro aqui é o do fio (regra 3). */
  .passo__halo {
    position: absolute;
    left: -3px;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--ouro);
    opacity: 0;
    pointer-events: none;
  }
  @supports (animation-timeline: view()) {
    .passo__halo {
      animation-name: halo;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-duration: auto;
      animation-timeline: --passo;
      animation-range: entry 30% entry 90%;
    }
  }
  @keyframes halo {
    from { opacity: 0.7; scale: 1; animation-timing-function: var(--ease-out); }
    to { opacity: 0; scale: 3.2; }
  }

  @keyframes fio-desce { from { transform: scaleY(0); } }
  @keyframes fio-deita { from { transform: scaleX(0); } }
  /* Nunca de scale(0): o ponto já existe pequeno e cresce. */
  @keyframes ponto {
    from { opacity: 0; transform: scale(0.5); animation-timing-function: var(--ease-out); }
  }
  @media (prefers-reduced-motion: reduce) {
    .passo::after, .passo::before, .passos::before { animation: none !important; }
    .passo__halo { display: none; }
  }

  .passo__titulo { font-family: var(--disp); font-weight: 400; font-size: var(--t-sub); }
  .passo__texto { margin-top: var(--s-3); }

  /* 64px no mobile / 96px no desktop (Mateus, 14/09/2026): com menos que isso o
     fecho lia como texto do último passo, e não como conclusão da seção. */
  .como__fecho { margin-top: var(--s-16); }

  @media (min-width: 900px) {
    .como { max-width: 960px; }
    .como__fecho { margin-top: calc(var(--s-16) + var(--s-8)); }

    .passos {
      --fio-gap: var(--s-12);
      position: relative;
      view-timeline: --passos block;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--fio-gap);
      max-width: none;
      margin-top: var(--s-16);
      padding-top: var(--s-8);
    }

    /* Mesma regra do fio deitado: começa no primeiro ponto e termina no
       último. A conta tira uma coluna da direita — com três colunas iguais,
       o recuo de 1fr é exatamente a borda esquerda do terceiro passo. */
    .passos::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: calc((100% - 2 * var(--fio-gap)) / 3);
      height: 1px;
      background: var(--ouro);
      transform-origin: left;
    }

    .passo { padding: 0; }
    .passo::after { content: none; }
    .passo::before,
    .passo__halo { left: -3px; top: calc(-1 * var(--s-8) - 3px); }

    /* No desktop o fio deita e corre da esquerda para a direita, ligando os
       três pontos; as colunas de texto chegam uma depois da outra. */
    @supports (animation-timeline: view()) {
      .passos::before {
        animation-name: fio-deita;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-duration: auto;
        animation-timeline: --passos;
        animation-range: entry 60% cover 50%;
      }
      .passo::before { animation-timeline: --passos; }
      .passo:nth-child(1)::before { animation-range: entry 40% entry 70%; }
      .passo:nth-child(2)::before { animation-range: entry 70% cover 40%; }
      .passo:nth-child(3)::before { animation-range: cover 30% cover 50%; }
      .passo__halo { animation-timeline: --passos; }
      .passo:nth-child(1) .passo__halo { animation-range: entry 60% cover 35%; }
      .passo:nth-child(2) .passo__halo { animation-range: cover 30% cover 50%; }
      .passo:nth-child(3) .passo__halo { animation-range: cover 45% cover 62%; }
      .passo:nth-child(2) .revela { animation-range: entry 15% cover 30%; }
      .passo:nth-child(3) .revela { animation-range: entry 30% cover 35%; }
    }
  }
</style>
