---
/**
 * Os oito ícones da página, desenhados à mão. Não há biblioteca de ícones no
 * projeto e não deve haver: oito desenhos não pagam uma dependência.
 *
 * Regra de cor: o traço é `currentColor`, então o ícone herda o tema claro/escuro
 * de quem o contém. NUNCA colorir de --ouro — a regra 3 do CLAUDE.md reserva o
 * ouro para a marca, o botão de WhatsApp e o fio de "Como funciona".
 *
 * Os seis ícones do reconhecimento desenham o MECANISMO, não o objeto: espiral
 * para o pensamento que gira, ciclo interrompido para o padrão que se repete,
 * dois círculos para o que existe entre duas pessoas, degraus para a régua que
 * sobe sempre, seta parada numa parede para o começo que não vem, contorno
 * tracejado para o espaço de cada um. Cérebro está fora — viraria rótulo de
 * neurociência, proibido pela regra 2.
 *
 * `pathLength="1"` nos traços: não muda o desenho, só normaliza o comprimento
 * para o Reconhecimento poder desenhá-los ao rolar (stroke-dashoffset 1 → 0).
 * Fica de fora do `limite`, que já é tracejado (o pathLength reescalaria o
 * tracejado dele), e do `whatsapp`, que é cheio.
 */

interface Props {
  nome: 'espiral' | 'pessoas' | 'ciclo' | 'degraus' | 'barreira' | 'limite' | 'livro' | 'whatsapp';
  tamanho?: number;
  classe?: string;
}

const { nome, tamanho = 24, classe } = Astro.props;

const desenhos: Record<Props['nome'], string> = {
  /* Pensamento em espiral — o idioma é literalmente esse. */
  espiral: `
    <path pathLength="1" d="M21 12 A9 9 0 0 0 3 12 A6.5 6.5 0 0 0 16 12 A4 4 0 0 0 8 12 A1.5 1.5 0 0 0 11 12" />
  `,
  /* Duas pessoas: o que importa é a área em que elas se sobrepõem. */
  pessoas: `
    <circle pathLength="1" cx="8.6" cy="12" r="6" />
    <circle pathLength="1" cx="15.4" cy="12" r="6" />
  `,
  /* O ciclo que se repete — e a abertura por onde ele pode ser interrompido. */
  ciclo: `
    <path pathLength="1" d="M15.9 5 A8 8 0 1 1 8.1 5" />
    <path pathLength="1" d="M5.1 5.1 L8.1 5 L6.5 7.5" />
  `,
  /* Autocrítica: cada degrau alcançado revela o próximo. */
  degraus: `
    <path pathLength="1" d="M3.5 19.5 H8.5 V14.5 H13.5 V9.5 H18.5 V4.5" />
    <path pathLength="1" d="M18.5 4.5 H20.5" />
  `,
  /* Procrastinação: a seta sabe para onde vai e para antes da parede. */
  barreira: `
    <path pathLength="1" d="M18 4.5 V19.5" />
    <path pathLength="1" d="M3.5 12 H13" />
    <path pathLength="1" d="M10 9 L13 12 L10 15" />
  `,
  /* Limites: um núcleo e o contorno do espaço dele. */
  limite: `
    <circle cx="12" cy="12" r="8.5" stroke-dasharray="2.6 2.6" />
    <circle cx="12" cy="12" r="3" />
  `,
  /* Livro aberto. */
  livro: `
    <path pathLength="1" d="M12 6.8 C10.4 5.4 8 4.8 3.8 4.8 L3.8 17.2 C8 17.2 10.4 17.8 12 19.2" />
    <path pathLength="1" d="M12 6.8 C13.6 5.4 16 4.8 20.2 4.8 L20.2 17.2 C16 17.2 13.6 17.8 12 19.2" />
    <path pathLength="1" d="M12 6.8 L12 19.2" />
  `,
  /* Glifo oficial do WhatsApp (balão com rabicho + fone), de Simple Icons
     (CC0). O desenho anterior era um fone genérico dentro de um círculo e não
     se lia como WhatsApp. É o único ícone cheio da página: a marca só é
     reconhecível no desenho original, então ele não segue o traço dos outros.
     A cor continua `currentColor` (claro sobre o botão), nunca --ouro. */
  whatsapp: `
    <path fill="currentColor" stroke="none" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
  `,
};
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={desenhos[nome]}
/>
